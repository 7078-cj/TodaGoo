# Copy to .env for running the app locally (npx expo start). .env is git-ignored.
# EAS builds don't use this file: each build profile (eas.json) reads its EAS environment
# (development / preview / production), set with `eas env:create`. See "Building the app" in README.md.
#
# EXPO_PUBLIC_* values are built into the app and can be read from it: don't put secrets here.

# REST API, ending in /api/ (a phone can't reach 127.0.0.1: use your computer's LAN IP)
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/

# WebSockets, the server root (optional: defaults to the API's host, http->ws / https->wss)
EXPO_PUBLIC_WS_URL=ws://192.168.1.10:8000/

# OpenRouteService key for drawing routes along roads (optional: straight lines without it)
EXPO_PUBLIC_ORS_API_KEY=

# --- build identity (app.config.js); usually set by eas.json, not here ---
# APP_VARIANT=development        # development | preview | production
# APP_ID=com.todagoo.app         # Android package / iOS bundle id (".dev" / ".preview" added)
# APP_VERSION=1.0.0
# EAS_PROJECT_ID=                # from `eas init`
# EXPO_OWNER=                    # expo.dev account / organization
